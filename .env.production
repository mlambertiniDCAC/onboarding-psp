# Producción. Vite hornea esta URL en el bundle en tiempo de build; un build de prod
# con esto vacío FALLA (guard en vite.config.js).
# No se commitea la URL: se carga como variable de entorno en Vercel.
# Sin prefijo VITE_ (así lo pide Vercel): se inyecta al bundle vía `define` en vite.config.js.
APIGW_PSP_URL=
