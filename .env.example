# Base URL of apigateway-psp (scheme + host + any gateway/k8s prefix; NOT including /v1).
VITE_APIGW_PSP_URL=
# Base URL of the DCAC host that exposes the federated `dcac/*` modules (auth interceptor).
VITE_DCAC_URL=
# "true" enables the standalone dev fallback (devAxiosInstance, token from ?token= or localStorage "tt").
VITE_ENABLE_LOGIN=false
